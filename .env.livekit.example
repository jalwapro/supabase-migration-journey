# LiveKit self-hosted server
# Production should use a TLS endpoint (wss://...), not ws:// on a public HTTPS app.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# Existing Supabase server-side values
SUPABASE_URL=https://your-project.supabase.co
SB_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_JWT_SECRET=replace_with_jwt_secret

# Oracle Cloud VM monitoring
# This URL must be the HTTPS-reachable endpoint for scripts/oracle-vm-monitor.mjs on the Oracle VM.
ORACLE_VM_MONITOR_URL=https://monitor.example.com
ORACLE_VM_MONITOR_SECRET=replace_with_long_random_secret

# Optional on the Oracle VM agent itself
VM_MONITOR_PORT=8787
LIVEKIT_METRICS_URL=http://127.0.0.1:7880/metrics
